{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aether-forge.dev/artifacts/memory-record.schema.json",
  "allOf": [
    {
      "$ref": "https://schemas.aether-forge.dev/common/artifact-envelope.schema.json"
    },
    {
      "type": "object",
      "required": [
        "ownerAgentId",
        "memoryType",
        "scope",
        "environment",
        "content",
        "summary",
        "source",
        "confidence",
        "sensitivity",
        "createdAt",
        "updatedAt",
        "provenanceRefs",
        "tags"
      ],
      "properties": {
        "artifactType": {
          "const": "memory-record"
        },
        "ownerAgentId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "artifactSetId": {
          "type": "string",
          "minLength": 1
        },
        "memoryType": {
          "type": "string",
          "enum": [
            "strategy-context",
            "operator-preference",
            "environment-fact",
            "venue-fact",
            "incident-learning",
            "evaluation-finding",
            "decision-history"
          ]
        },
        "scope": {
          "type": "string",
          "enum": [
            "session",
            "agent",
            "project",
            "environment"
          ]
        },
        "environment": {
          "type": "string",
          "enum": [
            "local",
            "sandbox",
            "shadow",
            "paper",
            "canary-live",
            "production"
          ]
        },
        "content": {
          "type": "object",
          "additionalProperties": true
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sensitivity": {
          "type": "string",
          "enum": [
            "public",
            "internal",
            "sensitive",
            "restricted"
          ]
        },
        "createdAt": {
          "type": "string",
          "minLength": 1
        },
        "updatedAt": {
          "type": "string",
          "minLength": 1
        },
        "expiresAt": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "retentionPolicy": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "provenanceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  ]
}
