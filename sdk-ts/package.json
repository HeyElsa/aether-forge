{
  "name": "@aether-forge/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Aether Forge — validators, types, and the language-agnostic planner-output parser. Conforms to the JSON schemas published at https://schemas.aether-forge.dev/.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src/schemas/generated"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:schemas": "tsx scripts/generate-schemas.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "json-schema-to-typescript": "^15.0.4",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "schemaCompat": "^0.23.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/HeyElsa/aether-forge"
  },
  "keywords": [
    "agent",
    "ai",
    "framework",
    "spec-first",
    "aether-forge",
    "x402",
    "erc-8004"
  ]
}
